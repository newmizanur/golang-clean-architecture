### GraphQL API — Item domain
# Works with REST Client (VS Code), IntelliJ HTTP Client, and Bruno.
# Get a token first via api.http → Login, then paste it below.

@graphqlUrl = http://localhost:4000/query
@token = <paste-token-here>

# ── Queries ──────────────────────────────────────────────────────────────────

### List items (paginated)
# @name listItems
POST {{graphqlUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query ListItems($filter: ListItemsInput!) { items(filter: $filter) { items { id name sku stock currency { code symbol decimalPlaces } createdAt updatedAt } total } }",
  "variables": {
    "filter": {
      "page": 1,
      "size": 10
    }
  }
}

### List items — with name filter
POST {{graphqlUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query ListItems($filter: ListItemsInput!) { items(filter: $filter) { items { id name sku stock currency { code symbol } } total } }",
  "variables": {
    "filter": {
      "name": "Keyboard",
      "page": 1,
      "size": 10
    }
  }
}

### List items — sorted
POST {{graphqlUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query ListItems($filter: ListItemsInput!) { items(filter: $filter) { items { id name stock } total } }",
  "variables": {
    "filter": {
      "sort": "stock",
      "page": 1,
      "size": 20
    }
  }
}

### Get single item by ID
POST {{graphqlUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetItem($id: ID!) { item(id: $id) { id name sku stock currency { code symbol decimalPlaces } createdAt updatedAt } }",
  "variables": {
    "id": "1"
  }
}

# ── Mutations ─────────────────────────────────────────────────────────────────

### Create item
# @name createItem
POST {{graphqlUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreateItem($input: CreateItemInput!) { createItem(input: $input) { id name sku stock currency { code symbol decimalPlaces } createdAt updatedAt } }",
  "variables": {
    "input": {
      "name": "Mechanical Keyboard",
      "sku": "KB-MECH-001",
      "currency": "USD",
      "stock": 50
    }
  }
}

### Create item (SGD)
POST {{graphqlUrl}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreateItem($input: CreateItemInput!) { createItem(input: $input) { id name sku stock currency { code symbol } } }",
  "variables": {
    "input": {
      "name": "Mouse",
      "sku": "MS-001",
      "currency": "SGD",
      "stock": 25
    }
  }
}
